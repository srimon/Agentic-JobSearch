{"uid": "jobsearch-operations", "title": "Jobsearch Operations", "schemaVersion": 39, "version": 1, "refresh": "15s", "time": {"from": "now-1h", "to": "now"}, "panels": [{"id": 1, "title": "Current opportunities", "type": "stat", "datasource": {"type": "prometheus", "uid": "jobsearch-prometheus"}, "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "jobsearch_current_matches", "refId": "A", "legendFormat": "{{job}} {{source_id}} {{outcome}} {{decision}}"}]}, {"id": 2, "title": "Enabled boards", "type": "stat", "datasource": {"type": "prometheus", "uid": "jobsearch-prometheus"}, "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "jobsearch_enabled_sources", "refId": "A", "legendFormat": "{{job}} {{source_id}} {{outcome}} {{decision}}"}]}, {"id": 3, "title": "Queued or running", "type": "stat", "datasource": {"type": "prometheus", "uid": "jobsearch-prometheus"}, "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "jobsearch_queue_depth", "refId": "A", "legendFormat": "{{job}} {{source_id}} {{outcome}} {{decision}}"}]}, {"id": 4, "title": "API and worker available", "type": "stat", "datasource": {"type": "prometheus", "uid": "jobsearch-prometheus"}, "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "up", "refId": "A", "legendFormat": "{{job}} {{source_id}} {{outcome}} {{decision}}"}]}, {"id": 5, "title": "API latency p95", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "jobsearch-prometheus"}, "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(jobsearch_http_duration_seconds_bucket[5m])))", "refId": "A", "legendFormat": "{{job}} {{source_id}} {{outcome}} {{decision}}"}]}, {"id": 6, "title": "Collection outcomes", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "jobsearch-prometheus"}, "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "targets": [{"expr": "sum by (outcome) (jobsearch_collection_runs_total)", "refId": "A", "legendFormat": "{{job}} {{source_id}} {{outcome}} {{decision}}"}]}, {"id": 7, "title": "Filtering decisions since worker start", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "jobsearch-prometheus"}, "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8}, "targets": [{"expr": "sum by (decision) (jobsearch_decisions_total)", "refId": "A", "legendFormat": "{{job}} {{source_id}} {{outcome}} {{decision}}"}]}, {"id": 8, "title": "Source freshness (seconds)", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "jobsearch-prometheus"}, "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8}, "targets": [{"expr": "time()-jobsearch_source_last_success_seconds", "refId": "A", "legendFormat": "{{job}} {{source_id}} {{outcome}} {{decision}}"}]}, {"id": 9, "title": "Active alerts", "type": "table", "datasource": {"type": "prometheus", "uid": "jobsearch-prometheus"}, "gridPos": {"x": 0, "y": 32, "w": 12, "h": 8}, "targets": [{"expr": "ALERTS{alertstate=\"firing\"}", "refId": "A", "legendFormat": "{{job}} {{source_id}} {{outcome}} {{decision}}"}]}, {"id": 10, "title": "Sanitized application events", "type": "logs", "datasource": {"type": "loki", "uid": "jobsearch-loki"}, "gridPos": {"x": 12, "y": 32, "w": 12, "h": 8}, "targets": [{"expr": "{job=\"jobsearch\"}", "refId": "A"}]}]}
