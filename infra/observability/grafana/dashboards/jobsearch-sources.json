{
  "uid": "jobsearch-sources",
  "title": "Jobsearch \u00b7 Sources & Queue",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "tags": [
    "jobsearch"
  ],
  "panels": [
    {
      "title": "Current observed matches",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "jobsearch-prometheus"
      },
      "description": "All observed matches before personal filters and archives.",
      "targets": [
        {
          "expr": "max without (instance) (jobsearch_current_matches)",
          "refId": "A",
          "legendFormat": "{{job}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Enabled sources",
