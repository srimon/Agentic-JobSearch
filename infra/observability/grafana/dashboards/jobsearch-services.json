{
  "uid": "jobsearch-services",
  "title": "Jobsearch \u00b7 API & Services",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "tags": [
    "jobsearch"
  ],
  "panels": [
    {
      "title": "Scrape target availability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "jobsearch-prometheus"
      },
      "description": "1 means the metrics endpoint is reachable; it does not prove every business workflow succeeded.",
      "targets": [
        {
          "expr": "up",
          "refId": "A",
          "legendFormat": "{{job}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Requests per second by route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "jobsearch-prometheus"
      },
      "description": "",
      "targets": [
        {
          "expr": "sum by (route) (rate(jobsearch_http_requests_total{route!=\"/api/monitoring/{tool}/{path:path}\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{route}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "API latency p50 \u00b7 rolling hour",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "jobsearch-prometheus"
      },
      "description": "",
      "targets": [
        {
          "expr": "histogram_quantile(0.5,sum by(le)(rate(jobsearch_http_duration_seconds_bucket[1h])))",
          "refId": "A",
          "legendFormat": "p50",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "API latency p95 \u00b7 rolling hour",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "jobsearch-prometheus"
      },
      "description": "",
      "targets": [
        {
          "expr": "jobsearch:api_latency_seconds:p95_1h",
          "refId": "A",
          "legendFormat": "p95",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "HTTP errors by route and status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "jobsearch-prometheus"
      },
      "description": "Empty means no matching error series; missing telemetry is not treated as zero.",
      "targets": [
        {
          "expr": "sum by(route,status)(increase(jobsearch_http_requests_total{status=~\"[45]..\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{status}} {{route}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Python process memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "jobsearch-prometheus"
      },
      "description": "",
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "refId": "A",
          "legendFormat": "{{job}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Python process CPU usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "jobsearch-prometheus"
      },
      "description": "API, collector and scheduler Python processes, not total container/host resource use.",
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total[5m])",
          "refId": "A",
          "legendFormat": "{{job}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Database metrics availability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "jobsearch-prometheus"
      },
      "description": "",
      "targets": [
        {
          "expr": "jobsearch_database_metrics_up",
          "refId": "A",
          "legendFormat": "{{job}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      }
    }
  ],
  "links": [
