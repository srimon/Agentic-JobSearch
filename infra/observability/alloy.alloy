local.file_match "jobsearch" {
  path_targets = [{"__path__" = "/logs/*.jsonl", "job" = "jobsearch"}]
}
loki.source.file "jobsearch" {
  targets = local.file_match.jobsearch.targets
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
