FROM node:22-alpine@sha256:76789712cd1ae89a1225eac9077010d68987a423588042dac30446f502f1858c AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_JOBSEARCH_ENVIRONMENT=production
ENV NEXT_PUBLIC_JOBSEARCH_ENVIRONMENT=$NEXT_PUBLIC_JOBSEARCH_ENVIRONMENT
# The path prefix the application is built under. Next bakes it in, so it is a build argument and
# not a setting: the image serves https://bagala.ai/jobsearch/ and the gateway gives the same
# prefix to requests that arrive on https://jobs.bagala.ai/ and the loopback name.
ARG NEXT_PUBLIC_JOBSEARCH_BASE_PATH=/jobsearch
ENV NEXT_PUBLIC_JOBSEARCH_BASE_PATH=$NEXT_PUBLIC_JOBSEARCH_BASE_PATH
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build
FROM node:22-alpine@sha256:76789712cd1ae89a1225eac9077010d68987a423588042dac30446f502f1858c
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3105 HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
USER node
CMD ["node","server.js"]
